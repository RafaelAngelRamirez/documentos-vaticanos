# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc
# Only exists if Bazel was run
/bazel-out

# dependencies
node_modules

# profiling files
chrome-profiler-events*.json

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.angular/cache
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db
.vscode
# Built installers / package artifacts (serve from CI image, not git)
*.apk
*.AppImage
*.exe
*.nsis.7z
frontend/android/local.properties
frontend/dist/
# monorepo package:all output
/dist/


# Crawl HTML cache (large)
documentos/crawl/**/cache/

# Padres: keep inventory + clean text + corpus JSON; skip heavy PDFs and raw extracts
documentos/padres-source/pdf/
documentos/padres-source/raw/

# Concilios: same policy (Mansi OCR dumps / PDFs are large)
documentos/concilios-source/pdf/
documentos/concilios-source/raw/


# Scrape work copies (canonical corpus is documentos/corpus + frontend assets)
scripts-descarga/documentos/

# electron-builder / tooling caches
.cache/
