{
  "name": "documentos-vaticanos",
  "version": "0.0.21",
  "private": true,
  "dependencies": {
    "googleapis": "^144.0.0",
    "standard-version": "^9.5.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:build": "bash scripts/dev.sh --build",
    "dev:down": "bash scripts/dev.sh --down",
    "dev:logs": "bash scripts/dev.sh --logs",
    "dev:status": "bash scripts/dev.sh --status",
    "dev:api-only": "bash scripts/dev.sh --api-only",
    "start": "bash scripts/dev.sh",
    "release": "standard-version && git push --follow-tags origin master && npm run build-docker production && ssh documentos@documentosvaticanos.digital './update-app'",
    "build-docker": "./docker-compilar.sh production",
    "build-docker-dev": "./docker-compilar.sh dev",
    "dev:docker": "bash scripts/dev.sh --build",
    "dev:docker:down": "bash scripts/dev.sh --down",
    "test:e2e": "docker compose -f docker-compose.dev.yml -p documentos-vaticanos --profile e2e run --rm e2e",
    "test:scrape": "node e2e/scrape-e2e.mjs",
    "test:scrape:unit": "npm --prefix scripts-descarga run test:scrape",
    "test:api": "node e2e/api-e2e.mjs",
    "test:refs": "npm --prefix scripts-descarga run test:refs",
    "test:unlinked-refs": "npm --prefix scripts-descarga run test:unlinked-refs",
    "inventory:unlinked-refs": "npm --prefix scripts-descarga run inventory:unlinked-refs",
    "test:corpus-structure": "node scripts-descarga/corpus_structure_contract.test.js",
    "test:electron-paths": "npm --prefix frontend run test:electron-paths",
    "dev:api": "npm --prefix backend run dev",
    "scrape": "npm --prefix scripts-descarga run scrape --",
    "resolve:refs": "npm --prefix scripts-descarga run resolve:refs",
    "package:web": "bash scripts/package-web.sh",
    "package:apk": "bash scripts/package-apk.sh",
    "package:electron": "bash scripts/package-electron.sh",
    "package:downloads": "bash scripts/package-collect-downloads.sh",
    "package:all": "bash scripts/package-all.sh",
    "corpus:compress": "node scripts/corpus-compress.js --root frontend/src/assets/corpus",
    "test:corpus-compress": "node scripts/corpus-compress.test.js",
    "test:downloads": "node frontend/src/app/core/downloads/downloads.paths.test.js",
    "test:version-display": "bash scripts/node-strip-types.sh frontend/src/app/core/downloads/version-display.logic.test.js",
    "test:app-update": "bash scripts/node-strip-types.sh frontend/src/app/core/downloads/app-update.logic.test.js",
    "test:apk-javahome": "node scripts/package-apk.javahome.test.js",
    "test:tts": "npm --prefix backend run test:tts",
    "test:narrator-grok": "npm --prefix frontend run test:narrator-grok",
    "test:speech-prep": "npm --prefix frontend run test:speech-prep",
    "test:document-toc": "npm --prefix frontend run test:document-toc",
    "test:santoral": "npm --prefix frontend run test:santoral && npm --prefix scripts-descarga run test:santoral",
    "santoral:offline": "npm --prefix scripts-descarga run santoral:offline",
    "santoral:scrape": "npm --prefix scripts-descarga run santoral:scrape",
    "context:build": "scripts-descarga/node_modules/.bin/ts-node --transpile-only scripts-descarga/build_historical_context.ts",
    "topics:build-graph": "scripts-descarga/node_modules/.bin/ts-node --transpile-only scripts-descarga/build_ref_graph.ts",
    "topics:build-seed": "scripts-descarga/node_modules/.bin/ts-node --transpile-only scripts-descarga/build_topics_seed.ts",
    "topics:build-postings": "scripts-descarga/node_modules/.bin/ts-node --transpile-only scripts-descarga/build_topic_postings.ts",
    "topics:validate": "scripts-descarga/node_modules/.bin/ts-node --transpile-only scripts-descarga/topics_validate.ts",
    "topics:build": "npm run topics:build-seed -- --locale es && npm run topics:build-postings -- --locale es --hubs-only",
    "test:topics-postings": "node scripts-descarga/topics_postings.test.js",
    "test:context": "node scripts-descarga/context_offline_load.test.js && node scripts-descarga/context_ui_wiring.test.js && bash scripts/node-strip-types.sh frontend/src/app/core/context/historical-context-resolve.logic.test.js",
    "test:search-load": "bash scripts/node-strip-types.sh frontend/src/app/core/search/search-load.logic.test.js",
    "test:topic-search": "bash scripts/node-strip-types.sh frontend/src/app/core/search/topic-search.logic.test.js",
    "package:aab": "bash scripts/package-aab.sh",
    "play:upload-closed": "node scripts/play-upload-closed.js",
    "test:android-version": "node scripts/android-version.test.js",
    "test:package-aab": "node scripts/package-aab.structure.test.js"
  },
  "packageManager": "yarn@1.22.22"
}
