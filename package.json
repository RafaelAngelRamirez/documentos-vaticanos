{
  "name": "documentos-vaticanos",
  "version": "0.0.14",
  "private": true,
  "dependencies": {
    "standard-version": "^9.5.0"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:build": "bash scripts/dev.sh --build",
    "dev:down": "bash scripts/dev.sh --down",
    "dev:logs": "bash scripts/dev.sh --logs",
    "dev:status": "bash scripts/dev.sh --status",
    "dev:api-only": "bash scripts/dev.sh --api-only",
    "start": "bash scripts/dev.sh",
    "release": "standard-version && git push --follow-tags origin master && npm run build-docker production && ssh documentos@documentosvaticanos.digital './update-app'",
    "build-docker": "./docker-compilar.sh production",
    "build-docker-dev": "./docker-compilar.sh dev",
    "dev:docker": "bash scripts/dev.sh --build",
    "dev:docker:down": "bash scripts/dev.sh --down",
    "test:e2e": "docker compose -f docker-compose.dev.yml -p documentos-vaticanos --profile e2e run --rm e2e",
    "test:scrape": "node e2e/scrape-e2e.mjs",
    "test:scrape:unit": "npm --prefix scripts-descarga run test:scrape",
    "test:api": "node e2e/api-e2e.mjs",
    "test:refs": "npm --prefix scripts-descarga run test:refs",
    "test:electron-paths": "npm --prefix frontend run test:electron-paths",
    "dev:api": "npm --prefix backend run dev",
    "scrape": "npm --prefix scripts-descarga run scrape --",
    "resolve:refs": "npm --prefix scripts-descarga run resolve:refs",
    "package:web": "bash scripts/package-web.sh",
    "package:apk": "bash scripts/package-apk.sh",
    "package:electron": "bash scripts/package-electron.sh",
    "package:downloads": "bash scripts/package-collect-downloads.sh",
    "package:all": "bash scripts/package-all.sh",
    "test:downloads": "node frontend/src/app/core/downloads/downloads.paths.test.js",
    "test:app-update": "node --experimental-strip-types frontend/src/app/core/downloads/app-update.logic.test.js",
    "test:apk-javahome": "node scripts/package-apk.javahome.test.js",
    "test:tts": "npm --prefix backend run test:tts",
    "test:narrator-grok": "npm --prefix frontend run test:narrator-grok",
    "test:speech-prep": "npm --prefix frontend run test:speech-prep"
  },
  "packageManager": "yarn@1.22.22"
}
