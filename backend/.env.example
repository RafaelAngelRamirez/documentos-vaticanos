# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/documentos_vaticanos?schema=public

# Google OAuth — Web client ID (audience for idToken verify)
# Comma-separated if you accept multiple client IDs (web + Android)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# App JWT (jose HS256)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL_DAYS=30

# Local-only: accept idToken starting with "dev:" without Google verify
# Format: dev:email@example.com or dev:email@example.com:Display Name
DEV_AUTH_BYPASS=false

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# xAI Grok TTS (opcional) — clave de console.x.ai, NO SuperGrok.
# SuperGrok/Heavy es suscripción del chat; el narrador usa la API TTS con
# facturación aparte (~$15/1M chars). Sin clave: solo voces del sistema.
# Nunca poner la clave en el frontend.
XAI_API_KEY=
# XAI_TTS_BASE_URL=https://api.x.ai/v1
