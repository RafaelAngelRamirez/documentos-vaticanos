  "main": "index.ts",
  "scripts": {
    "catecismo": "npx ts-node-dev --transpile-only --project tsconfig.json descargar_catecismo.ts && npm run copiar",
    "biblia": "npx ts-node-dev --transpile-only --project tsconfig.json descargar_biblia.ts && npm run copiar",
